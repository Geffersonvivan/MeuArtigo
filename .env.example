# === Meu Artigo — modelo de variáveis de ambiente ===
# Copie para .env e preencha. NUNCA versione o .env real.

# Django
DJANGO_SECRET_KEY=troque-por-uma-chave-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=America/Sao_Paulo

# PostgreSQL + pgvector (local). Em produção use DATABASE_URL (Railway fornece).
POSTGRES_DB=meu_artigo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# DATABASE_URL=postgres://user:pass@host:5432/dbname   # produção (tem prioridade)

# === Produção (DJANGO_DEBUG=False ativa o hardening de segurança) ===
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=seu-dominio.com
# CSRF_TRUSTED_ORIGINS=https://seu-dominio.com
# USD_BRL=5.40

# Armazenamento físico dos artigos (opcional; padrão = ./artigos)
# ARTIGOS_ROOT=/caminho/absoluto/artigos

# LLMs (Claude + Perplexity; OpenAI foi descartado)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

# Embeddings — Voyage AI (parceiro recomendado pela Anthropic)
VOYAGE_API_KEY=
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-3.5
EMBEDDING_DIMENSIONS=1024
